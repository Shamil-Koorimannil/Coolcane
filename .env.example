# Getlead CRM API Configuration (Server-Side Only - Never commit real keys to Git)
GETLEAD_API_KEY=replace_with_your_real_api_key

# Mode: 'demo' (simulated submissions for local development) or 'live' (real Getlead CRM)
GETLEAD_MODE=demo

# Getlead API Base URL (default is https://v3.getleadcrm.com/api/v1)
GETLEAD_API_URL=https://v3.getleadcrm.com/api/v1

# CoolCane Public Configuration
VITE_COMPANY_PROFILE_URL=/CoolCane-Company-Profile.pdf
VITE_MAIN_WEBSITE_URL=/
